{
  "name": "gapai-document-analytics",
  "productName": "Gapai Document Analytics",
  "version": "0.1.0",
  "description": "Gapai Document Analytics: cross-check documents for inconsistent information using AI",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/compare.test.js && node test/store.test.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "author": "Gapai",
  "license": "UNLICENSED",
  "private": true,
  "build": {
    "appId": "com.gapai.documentanalytics",
    "productName": "Gapai Document Analytics",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
